# 复制为 .env 并填入真实值；.env 已被 gitignore，禁止提交。
# 完整连接方式见 docs/middleware-deploy.md 或 /pipewise/middleware/

PW_API_PORT=18081

# 应用登录（生产请在部署机用强密码）
PW_AUTH_USER=pipewise
PW_AUTH_PASSWORD=change-me
PW_AUTH_SESSION_DAYS=7

# PostgreSQL
PW_PG_URL=jdbc:postgresql://111.228.14.136:5434/pipewise
PW_PG_USER=pipewise
PW_PG_PASSWORD=change-me

# Redis
PW_REDIS_HOST=111.228.14.136
PW_REDIS_PORT=6380
PW_REDIS_PASSWORD=change-me

# MinIO
PW_MINIO_ENDPOINT=http://111.228.14.136:9010
PW_MINIO_ACCESS_KEY=pipewise
PW_MINIO_SECRET_KEY=change-me
PW_MINIO_BUCKET=pipewise

# RocketMQ
PW_ROCKETMQ_NAMESRV=111.228.14.136:9876
PW_ROCKETMQ_ACCESS_KEY=pipewise
PW_ROCKETMQ_SECRET_KEY=change-me
PW_ROCKETMQ_TOPIC=pipewise_health_check
