<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://pipewise.example/flowable">

    <!--
      或签：任意一人同意即通过；单个否决不终结，等其他人“救”；
      所有人都否决时才失败。
      完成条件：approveCount > 0 || 所有人都已完成
    -->
    <process id="demo_or_sign" name="或签演示" isExecutable="true">
        <startEvent id="start"/>
        <sequenceFlow id="f1" sourceRef="start" targetRef="sign"/>

        <userTask id="sign" name="或签审批" flowable:assignee="${assignee}">
            <extensionElements>
                <flowable:taskListener event="complete" delegateExpression="${verdictListener}"/>
            </extensionElements>
            <multiInstanceLoopCharacteristics isSequential="false"
                                              flowable:collection="${assignees}"
                                              flowable:elementVariable="assignee">
                <completionCondition><![CDATA[${approveCount > 0 || nrOfCompletedInstances == nrOfInstances}]]></completionCondition>
            </multiInstanceLoopCharacteristics>
        </userTask>

        <exclusiveGateway id="gw" default="toRejected"/>
        <sequenceFlow id="f2" sourceRef="sign" targetRef="gw"/>
        <sequenceFlow id="toApproved" sourceRef="gw" targetRef="approvedEnd">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${approveCount > 0}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="toRejected" sourceRef="gw" targetRef="rejectedEnd"/>

        <endEvent id="approvedEnd"/>
        <endEvent id="rejectedEnd"/>
    </process>
</definitions>
